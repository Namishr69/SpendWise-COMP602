PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---------------------------------------------------------------------------
# ANZ Open Banking (Payments NZ API Centre sandbox)
# ---------------------------------------------------------------------------

# Requires ANZ_CLIENT_ID, ANZ_KEY_ID and the PS512 private key below.

# From your API Centre client registration.
ANZ_CLIENT_ID=
ANZ_KEY_ID=

# PS512 signing key. Never commit this file — *.pem is gitignored.
ANZ_PRIVATE_KEY_PATH=./anz-private-key.pem

# OAuth endpoints are derived from the issuer, matching the sandbox's
# /.well-known/openid-configuration document.
ANZ_ISSUER=https://api-nomatls.apicentre.middleware.co.nz/

# Account Information API base path. Confirm the version against your
# onboarding pack — this is the value most likely to need changing.
ANZ_RESOURCE_BASE_URL=https://api-nomatls.apicentre.middleware.co.nz/account-information/v2.3

# Must match a redirect URI registered in the API Centre portal byte-for-byte.
# Points at the frontend so the callback can be forwarded to the backend with
# the user's Firebase ID token attached.
ANZ_REDIRECT_URI=http://localhost:5173/anz/callback

ANZ_SCOPES=openid accounts

# 'code' returns the result in the query string. Switch to 'code id_token' if
# the sandbox rejects plain code — the callback page handles both.
ANZ_RESPONSE_TYPE=code

# Push the request object server-side instead of putting it in the URL.
ANZ_USE_PAR=false

# Overrides the `aud` on client assertions. Only needed if the sandbox wants
# the token endpoint URL rather than the issuer.
# ANZ_TOKEN_AUDIENCE=
