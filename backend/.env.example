PORT=3000

# Firebase Admin service account. Local dev reads backend/serviceAccountKey.json
# (gitignored). Hosted deploys can instead set SERVICE_ACCOUNT_JSON to the full
# service-account JSON on one line, which takes precedence over the file.
# SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# ANZ Open Banking (Payments NZ API Centre sandbox)
# ---------------------------------------------------------------------------

# Requires ANZ_CLIENT_ID, ANZ_KEY_ID and the PS512 private key below.

# From your API Centre client registration.
ANZ_CLIENT_ID=
ANZ_KEY_ID=

# PS512 signing key. Local dev reads it from a file — never commit it (*.pem is
# gitignored). Hosted deploys (e.g. Render) can instead paste the whole PEM into
# ANZ_PRIVATE_KEY, which takes precedence over the path when set.
ANZ_PRIVATE_KEY_PATH=./anz-private-key.pem
# ANZ_PRIVATE_KEY=

# OAuth endpoints are derived from the issuer, matching the sandbox's
# /.well-known/openid-configuration document.
ANZ_ISSUER=https://api-nomatls.apicentre.middleware.co.nz/

# Account Information API base path. Confirm the version against your
# onboarding pack — this is the value most likely to need changing.
ANZ_RESOURCE_BASE_URL=https://api-nomatls.apicentre.middleware.co.nz/account-information/v2.3

# Must match a redirect URI registered in the API Centre portal byte-for-byte.
# Points at the frontend so the callback can be forwarded to the backend with
# the user's Firebase ID token attached.
ANZ_REDIRECT_URI=http://localhost:5173/anz/callback

ANZ_SCOPES=openid accounts

# 'code' returns the result in the query string. Switch to 'code id_token' if
# the sandbox rejects plain code — the callback page handles both.
ANZ_RESPONSE_TYPE=code

# Push the request object server-side instead of putting it in the URL.
ANZ_USE_PAR=false

# Overrides the `aud` on client assertions. Only needed if the sandbox wants
# the token endpoint URL rather than the issuer.
# ANZ_TOKEN_AUDIENCE=

# ---------------------------------------------------------------------------
# Gmail (read-only) via Google OAuth 2.0 — "Connect Gmail" feature
# ---------------------------------------------------------------------------
#
# One-time Google Cloud setup:
#   1. OAuth consent screen: External, publishing status "Testing". Add the
#      scope .../auth/gmail.readonly and add each tester's Gmail as a Test user
#      (Testing mode skips Google's app verification — fine for the project).
#   2. Create an OAuth client ID of type "Web application". Add the redirect URI
#      below (and the deployed frontend's /gmail/callback for prod) byte-for-byte.
#
# The client secret stays backend-only — never expose it as a VITE_* var.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Must match an Authorized redirect URI on the OAuth client exactly. Points at
# the frontend so the callback is forwarded to the backend with the user's
# Firebase ID token attached (same reason as ANZ_REDIRECT_URI above).
GMAIL_REDIRECT_URI=http://localhost:5173/gmail/callback

# Read-only mailbox access + identity. Defaulted in code; override only to
# widen/narrow scope.
# GMAIL_SCOPES=openid email https://www.googleapis.com/auth/gmail.readonly
